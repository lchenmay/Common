    "Stop": [{ "hooks": [{ "type": "command", "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"D:\\DEV\\Common\\CodexPolicy\\Stop.ps1\" -PolicyPath \"D:\\DEV\\Common\\.codex\\policy.json\"", "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"D:\\DEV\\Common\\CodexPolicy\\Stop.ps1\" -PolicyPath \"D:\\DEV\\Common\\.codex\\policy.json\"", "timeout": 10, "statusMessage": "Checking Common completion gate" }] }]
  }
